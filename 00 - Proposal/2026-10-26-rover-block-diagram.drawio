<mxfile host="app.diagrams.net" type="device">
  <diagram id="rover-block" name="Functional Block Diagram">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title and note -->
        <mxCell id="title" value="Telemetry Rover with Link-Loss Return-to-Start: Functional Block Diagram (MVP)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="Pin numbers from the RSLK lab curriculum; verify against board and lab code. Battery sense pin TBD." style="text;html=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="900" height="20" as="geometry"/>
        </mxCell>

        <!-- Laptop group -->
        <mxCell id="lap" value="Windows Laptop" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="220" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="kb" value="Keyboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="prog" value="&lt;b&gt;Control Program (C)&lt;/b&gt;&lt;br&gt;teleop, 10 Hz drive/heartbeat,&lt;br&gt;telemetry display, CSV log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="btcom" value="Bluetooth COM Port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="usb" value="USB (debug / flashing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- HC-05 -->
        <mxCell id="hc05" value="&lt;b&gt;HC-05&lt;/b&gt;&lt;br&gt;Bluetooth module" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="130" height="60" as="geometry"/>
        </mxCell>

        <!-- MSP432 group -->
        <mxCell id="msp" value="MSP432P401R LaunchPad" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="490" y="80" width="320" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="fsm" value="&lt;b&gt;Mode FSM&lt;/b&gt;&lt;br&gt;BOOT, READY, TELEOP, LINK_LOST,&lt;br&gt;RETURNING, HOME, BLOCKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="510" y="115" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;Control&lt;/b&gt;&lt;br&gt;PI wheel speed, odometry,&lt;br&gt;return-to-start, stall check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="510" y="195" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="uart" value="&lt;b&gt;UART (eUSCI_A2)&lt;/b&gt;&lt;br&gt;ring buffers + packet parser (CRC-8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="510" y="280" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="timers" value="&lt;b&gt;Timers / Interrupts&lt;/b&gt;&lt;br&gt;TA0 PWM, TA3 capture, TA1 100 Hz tick, SysTick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="510" y="360" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gpio" value="&lt;b&gt;GPIO&lt;/b&gt;&lt;br&gt;motor DIR/SLEEP, encoder B, bump IRQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="510" y="440" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="adc" value="&lt;b&gt;ADC14&lt;/b&gt; (battery voltage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="510" y="520" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="dbg" value="&lt;b&gt;Debug UART&lt;/b&gt; (eUSCI_A0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="510" y="580" width="280" height="40" as="geometry"/>
        </mxCell>

        <!-- Robot hardware -->
        <mxCell id="drv" value="&lt;b&gt;Motor Driver&lt;/b&gt;&lt;br&gt;(RSLK power board)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="motors" value="Left + Right DC Motors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="enc" value="Left + Right Encoders&lt;br&gt;(quadrature A/B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="300" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="bump" value="Bump Switches (x6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="440" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="batt" value="Battery Pack (6x AA)&lt;br&gt;+ divider (TBD)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="880" y="520" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- Laptop internal connections -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="kb" target="prog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="prog" target="btcom">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Wireless link -->
        <mxCell id="e3" value="Bluetooth SPP&lt;br&gt;commands / telemetry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;fontSize=10;" edge="1" parent="1" source="btcom" target="hc05">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="UART TX/RX&lt;br&gt;P3.3 / P3.2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;" edge="1" parent="1" source="hc05" target="uart">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- MSP432 internal -->
        <mxCell id="e5" value="commands" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0.85;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="uart" target="ctrl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="fsm" target="ctrl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- MSP432 to robot hardware -->
        <mxCell id="e7" value="PWM P2.7 / P2.6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="timers" target="drv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="DIR / SLEEP (GPIO)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.2;entryX=0;entryY=0.7;" edge="1" parent="1" source="gpio" target="drv">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="drv" target="motors">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="Ch A: TA3 capture" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.3;entryX=1;entryY=0.7;" edge="1" parent="1" source="enc" target="timers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e11" value="Ch B: GPIO" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="enc" target="gpio">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e12" value="GPIO IRQ (Port 4)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.8;" edge="1" parent="1" source="bump" target="gpio">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e13" value="ADC (pin TBD)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="batt" target="adc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Debug link -->
        <mxCell id="e14" value="USB backchannel P1.2 / P1.3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;" edge="1" parent="1" source="dbg" target="usb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="600"/>
              <mxPoint x="460" y="460"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
